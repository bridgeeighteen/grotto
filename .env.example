# ---------------------------------------------------------------------------
# Grotto configuration
# Copy to .env. Grotto does not store platform API keys.
#
# Callers send the key for the target platform with every proxy request:
#   Authorization: Bearer <platform-api-key>
# Grotto forwards that key to the platform and keeps it only in memory for the
# lifetime of the request. Never put provider keys in this file.
# ---------------------------------------------------------------------------

# Public origin used in /grotto/info and the UI. Set this behind a reverse proxy.
GROTTO_PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated platform IDs. Leave unset to enable all registered platforms.
GROTTO_PLATFORMS=bailian,modelscope,volcengine

# --- Upstream endpoints (not credentials) ---------------------------------
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_ALLOWED_REGIONS=

MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# ModelScope audio routes depend on the selected model; enable explicitly.
MODELSCOPE_AUDIO_ENABLED=false

VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- System prompt contract ------------------------------------------------
GROTTO_SYSTEM_PROMPT_ENABLED=true
GROTTO_EXPOSE_SYSTEM_PROMPT=true
# GROTTO_SYSTEM_PROMPT="You are a helpful assistant..."

# --- Rate limiting ---------------------------------------------------------
# Requests are grouped by a one-way fingerprint of the caller's platform key.
GROTTO_RATE_LIMIT_ENABLED=true
GROTTO_RATE_LIMIT_MAX=60
GROTTO_RATE_LIMIT_WINDOW=60
# Defaults to storage/cache/rate_limit. Use a shared store for multi-host deployments.
# GROTTO_RATE_LIMIT_STORAGE=/var/lib/grotto/rate_limit

# --- CORS ------------------------------------------------------------------
# Use explicit origins in production, e.g. https://chat.example.com
GROTTO_CORS_ORIGINS=*
GROTTO_CORS_CREDENTIALS=false

# --- Reverse proxy / outbound HTTP ----------------------------------------
GROTTO_UPSTREAM_TIMEOUT=120
GROTTO_UPSTREAM_CONNECT_TIMEOUT=10
GROTTO_UPSTREAM_VERIFY_SSL=true

# Async image/video polling. Keep the total wait below your proxy timeout.
GROTTO_ASYNC_POLL_INTERVAL_MS=1000
GROTTO_ASYNC_TIMEOUT=300
GROTTO_ASYNC_MAX_ATTEMPTS=600

# --- Image metadata --------------------------------------------------------
GROTTO_SANITIZE_IMAGES=true
GROTTO_SANITIZE_PLATFORMS=bailian,modelscope,volcengine

# --- Logging / UI ----------------------------------------------------------
GROTTO_LOG_LEVEL=info
GROTTO_LOG_PATH=storage/logs/grotto.log
GROTTO_UI_ENABLED=true
